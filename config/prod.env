# Configuration of the hosted demo (https://loosen.sicena.com/demo/, CT 147). The .env is generated by prod/bin/deploy.py (genera-env); everything
# in this file is public. The secrets are in prod.secrets.env.sops (SOPS-encrypted), shared blocks come from prod/config/blocs.

# The one origin whose pages may call loosend from a browser: the demo is served by the loosen shop at loosen.sicena.com/demo/ (same origin).
LOOSEND_ALLOWED_ORIGINS=https://loosen.sicena.com

# Production-signed licence key (plan dev, valid until 2036) for the host loosen.sicena.com, issued with `loosen token` on CT 147:
#   ssh root@192.168.140.147 'cd /opt/loosen/current && set -a && . ./.env && set +a && ./loosen token -plan dev -domains loosen.sicena.com -days 3650 -customer "Loosen examples demo" -id lic_demo_examples'
# It is public by design (domain-bound, in config.js, which deploy/build.sh generates from it).
LOOSEN_LICENCE=LSN1.eyJ2IjoxLCJpZCI6ImxpY19kZW1vX2V4YW1wbGVzIiwicGxhbiI6ImRldiIsImN1c3RvbWVyIjoiTG9vc2VuIGV4YW1wbGVzIGRlbW8iLCJkb21haW5zIjpbImxvb3Nlbi5zaWNlbmEuY29tIl0sIm1heEl0ZW1zIjo1MDAwMCwiYmFkZ2UiOnRydWUsImlhdCI6MTc5MzIyMDM0OSwiZXhwIjoyMTA4NTgwMzQ5fQ.h5dFzwWO38ZZTubjzDqq2YmKE_n1qy0OU_10MKbUbrb1kF8NxYSa54XaVvzbZDPjOrpbMhUt6sTfUMVLKGnmBA

